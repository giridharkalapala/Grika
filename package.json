{
  "name": "tailorsnap",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "cd android && gradlew.bat assembleRelease",
    "build:apk:debug": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "expo": "~52.0.28",
    "expo-asset": "~11.0.3",
    "expo-clipboard": "~7.0.1",
    "expo-image-picker": "~16.0.5",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.469.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~12.0.7"
  },
  "private": true
}
